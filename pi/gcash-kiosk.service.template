[Unit]
Description=GCash Kiosk Flask Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP_DIR__/.venv/bin/python __APP_DIR__/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
